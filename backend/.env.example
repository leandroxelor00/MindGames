# Copie para .env e preencha. NUNCA commite o .env.
# Gere um segredo forte, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Porta da API (padrão 3001; hospedagens costumam definir sozinhas)
PORT=3001

# Origem(ns) do front permitidas no CORS, separadas por vírgula, sem barra no final
CORS_ORIGIN=http://localhost:5173

# --- Banco de dados ---
# Produção (Turso): preencha as duas e o arquivo local é ignorado.
# TURSO_DATABASE_URL=libsql://seu-banco-seu-usuario.turso.io
# TURSO_AUTH_TOKEN=token-gerado-no-painel

# Desenvolvimento: arquivo SQLite local (padrão: backend/mindgames.db)
# DB_PATH=/caminho/para/mindgames.db
