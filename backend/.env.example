# Copie para .env e preencha. NUNCA commite o .env.
# Gere um segredo forte, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Porta da API (padrão 3001)
PORT=3001

# Origem(ns) do front permitidas no CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:5173

# Caminho do arquivo SQLite (padrão: backend/mindgames.db).
# Em produção, aponte para um volume persistente.
# DB_PATH=/data/mindgames.db
